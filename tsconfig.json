{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "target": "ES2020",
    "module": "ES2020",

    // Type Checking
    "strict": true,
    "skipLibCheck": true,

    // JavaScript Output
    "sourceMap": true
  },

  // Files to compile
  "include": ["src/**/*.ts"],

  // Files and folders to exclude
  "exclude": ["node_modules", "dist"]
}
